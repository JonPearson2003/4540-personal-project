<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="BuildTrack.App.Views.ProjectAssignmentsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:BuildTrack.Contracts.Models;assembly=BuildTrack.Contracts"
	xmlns:vm="clr-namespace:BuildTrack.App.ViewModels"
	x:DataType="vm:ProjectAssignmentsViewModel" Title="Assignments" Background="#F7F8FA">
	<Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
		<Grid ColumnDefinitions="*,Auto">
			<VerticalStackLayout>
				<Label Text="Project assignments" FontSize="24" FontAttributes="Bold" TextColor="#17202A" />
				<Label Text="Connect workers to projects" TextColor="#52606D" />
			</VerticalStackLayout>
			<Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" Background="#006D77" TextColor="White" />
		</Grid>
		<Label Grid.Row="1" IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="#B42318" />
		<RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
			<CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
				<CollectionView.EmptyView><Label Text="No assignments yet." HorizontalOptions="Center" VerticalOptions="Center" /></CollectionView.EmptyView>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:ProjectAssignmentDto">
						<Border Margin="0,0,0,10" Padding="14" Background="White" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8">
							<VerticalStackLayout Spacing="6">
								<Label Text="{Binding ProjectId, StringFormat='Project: {0}'}" FontSize="18" FontAttributes="Bold" TextColor="#17202A" />
								<Label Text="{Binding UserId, StringFormat='User: {0}'}" TextColor="#52606D" />
								<Label Text="{Binding AssignedAt, StringFormat='Assigned: {0:g}'}" TextColor="#52606D" />
								<HorizontalStackLayout Spacing="8">
									<Button Text="Edit" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectAssignmentsViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" Background="#006D77" TextColor="White" />
									<Button Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectAssignmentsViewModel}}, Path=DeleteCommand}" CommandParameter="{Binding .}" Background="#B42318" TextColor="White" />
								</HorizontalStackLayout>
							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>
		<ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#006D77" />
	</Grid>
</ContentPage>
