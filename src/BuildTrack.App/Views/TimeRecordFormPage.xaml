<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="BuildTrack.App.Views.TimeRecordFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:BuildTrack.App.ViewModels"
	x:DataType="vm:TimeRecordFormViewModel" Title="Time record" Background="#F7F8FA">
	<Grid>
		<ScrollView>
			<VerticalStackLayout Padding="20" Spacing="12">
				<Label Text="Time record" FontSize="24" FontAttributes="Bold" TextColor="#17202A" />
				<Label Text="{Binding RecordKey, StringFormat='Record #{0}'}" IsVisible="{Binding IsEditing}" TextColor="#52606D" />
				<Label Text="User ID" TextColor="#17202A" />
				<Entry Text="{Binding UserId}" Keyboard="Numeric" Placeholder="User ID (required)" IsReadOnly="{Binding IsEditing}" Background="White" />
				<Label Text="Project ID (optional)" TextColor="#17202A" />
				<Entry Text="{Binding ProjectId}" Keyboard="Numeric" Placeholder="Leave blank if not assigned" Background="White" />
				<Label Text="Start time" TextColor="#17202A" />
				<DatePicker Date="{Binding StartTime}" />
				<TimePicker Time="{Binding StartTimeOfDay, Mode=TwoWay}" />
				<HorizontalStackLayout Spacing="8">
					<CheckBox IsChecked="{Binding IsInProgress}" />
					<Label Text="Still in progress" VerticalOptions="Center" TextColor="#17202A" />
				</HorizontalStackLayout>
				<Label Text="End time" TextColor="#17202A" />
				<DatePicker Date="{Binding EndTime}" IsEnabled="{Binding IsCompleted}" />
				<TimePicker Time="{Binding EndTimeOfDay, Mode=TwoWay}" IsEnabled="{Binding IsCompleted}" />
				<Label Text="Calculated duration" TextColor="#17202A" />
				<Label Text="{Binding DurationText}" TextColor="#006D77" FontAttributes="Bold" />
				<Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="#B42318" />
				<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
					<Button Text="Save" Command="{Binding SaveCommand}" Background="#006D77" TextColor="White" />
					<Button Grid.Column="1" Text="Cancel" Command="{Binding CancelCommand}" Background="#E2E8F0" TextColor="#17202A" />
				</Grid>
				<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#006D77" />
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>
