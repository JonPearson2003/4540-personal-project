<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="BuildTrack.App.Views.ProjectFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:BuildTrack.App.ViewModels"
	x:DataType="vm:ProjectFormViewModel" Title="Project" Background="#F7F8FA">
	<Grid>
		<ScrollView>
			<VerticalStackLayout Padding="20" Spacing="12">
				<Label Text="Project details" FontSize="24" FontAttributes="Bold" TextColor="#17202A" />
				<Label Text="{Binding RecordKey, StringFormat='Project #{0}'}" IsVisible="{Binding IsEditing}" TextColor="#52606D" />
				<Label Text="Name" TextColor="#17202A" />
				<Entry Text="{Binding Name}" Placeholder="Project name" Background="White" />
				<Label Text="Description" TextColor="#17202A" />
				<Editor Text="{Binding Description}" Placeholder="Project description" AutoSize="TextChanges" BackgroundColor="White" />
				<Label Text="Location" TextColor="#17202A" />
				<Entry Text="{Binding Location}" Placeholder="Project location" Background="White" />
				<Label Text="Start date" TextColor="#17202A" />
				<DatePicker Date="{Binding StartDate}" />
				<Label Text="End date" TextColor="#17202A" />
				<DatePicker Date="{Binding EndDate}" />
				<Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="#B42318" />
				<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
					<Button Text="Save" Command="{Binding SaveCommand}" Background="#006D77" TextColor="White" />
					<Button Grid.Column="1" Text="Cancel" Command="{Binding CancelCommand}" Background="#E2E8F0" TextColor="#17202A" />
				</Grid>
				<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#006D77" />
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>
